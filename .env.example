# Demo mode works with this file unchanged. Never commit real credentials.
STUDYMATE_ENABLE_LIVE_AI=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
# Set to the exact app origin when running behind a reverse proxy.
STUDYMATE_APP_ORIGIN=

# Continuous speech translation is a separate direct Google service.
# Keep the hosted SSO allowlist on /api/live/* before enabling it.
STUDYMATE_ENABLE_LIVE_TRANSLATION=false
GEMINI_LIVE_API_KEY=
