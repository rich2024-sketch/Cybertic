# Demo mode works with this file unchanged. Never commit real credentials.
STUDYMATE_ENABLE_LIVE_AI=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
# Optional direct Gemini text model override when using GEMINI_LIVE_API_KEY
# for summaries, translation, and assignment extraction.
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Set to the exact app origin when running behind a reverse proxy.
STUDYMATE_APP_ORIGIN=

# Continuous speech translation is a separate direct Google service.
# Keep the hosted SSO allowlist on /api/live/* before enabling it.
STUDYMATE_ENABLE_LIVE_TRANSLATION=false
GEMINI_LIVE_API_KEY=

# Authenticated student workspaces use Cloudflare Access JWT verification.
# Configure these as runtime variables on Cloudflare for production.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional local-only preview identity when Cloudflare Access is absent.
# Leave disabled in production.
STUDYMATE_ALLOW_DEV_AUTH_MOCK=false
STUDYMATE_DEV_ACCESS_EMAIL=student@example.com
STUDYMATE_DEV_ACCESS_NAME=Local Student
